# Environment variables for Cloistr backend
# Copy this to .env and fill in your values.
# Never commit the actual .env file.

APP_ENV=development
APP_CORS_ORIGINS=["http://localhost:5176","http://127.0.0.1:5176"]
APP_FRONTEND_BASE_URL=http://localhost:5176
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cloistr
APP_MAIL_FROM_ADDRESS=no-reply@cloistr.local

# SMTP — optional, needed for password reset emails
# APP_SMTP_HOST=smtp-relay.brevo.com
# APP_SMTP_PORT=587
# APP_SMTP_USERNAME=apikey
# APP_SMTP_PASSWORD=your-smtp-api-key
# APP_SMTP_USE_TLS=true
# APP_SMTP_USE_SSL=false
# APP_SMTP_TIMEOUT_SECONDS=10

# OAuth — optional, needed for social login
# APP_GOOGLE_CLIENT_ID=your-google-client-id
# APP_GOOGLE_CLIENT_SECRET=your-google-client-secret
# APP_GITHUB_CLIENT_ID=your-github-client-id
# APP_GITHUB_CLIENT_SECRET=your-github-client-secret
